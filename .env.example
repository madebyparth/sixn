# NTS — Not That Simple. Copy to .env and fill in. Never commit .env.
# Empty values (or REPLACE_ME) mean "not configured": the app still starts and logs which features are off.
# `python preflight.py` lists everything still missing for launch.

# =====================================================================
# REQUIRED FOR LAUNCH
# =====================================================================

# --- Core ---
# Random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# MongoDB connection string (e.g. Atlas: mongodb+srv://user:pass@cluster/nts)
MONGO_URI=
# Fernet keys for encrypting phone numbers and addresses:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
PHONE_ENCRYPTION_KEY=
ADDRESS_ENCRYPTION_KEY=
# User id of the admin account (sign up once, then copy the id here)
ADMIN_USER_ID=

# --- Payments: Razorpay (live keys after KYC) ---
# Google Pay: no separate key. In India, Google Pay is paid through Razorpay's UPI option,
# which the checkout shows first. Enable UPI in the Razorpay dashboard.
RAZORPAY_KEY=
RAZORPAY_SECRET=
# Razorpay Dashboard -> Webhooks: URL https://<your-domain>/api/payment/webhook,
# events payment.captured + order.paid. Records paid orders even if the shopper closes the tab.
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping: Shiprocket (use an API user, not your dashboard login) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact pickup location name and PIN as set up in Shiprocket
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=

# --- SMS OTP: Twilio ---
# Needed for admin sign-in (password + OTP). Customers check out as guests by email.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# --- Business details (shown on Terms / Privacy / Returns / Contact; required by Razorpay and the
#     Consumer Protection (E-Commerce) Rules, 2020). Empty values show as highlighted gaps on those pages.
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
BUSINESS_JURISDICTION_CITY=
SUPPORT_EMAIL=
SUPPORT_PHONE=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=

# =====================================================================
# OPTIONAL FOR NOW
# =====================================================================

# Days after delivery during which a return can be requested (enforced in code, shown on /returns)
RETURN_WINDOW_DAYS=7

# 1 = customers can sign up / log in with phone + OTP (needs Twilio). 0 = guest checkout by email only.
# Admins can always sign in.
PHONE_LOGIN_ENABLED=0

# 1 = guests must confirm their email before ordering. Leave 0: no confirmation email is sent yet,
# so turning this on would block guest checkout.
REQUIRE_EMAIL_CONFIRMATION=0

# Google sign-in ("Continue with Google" in the sign-in modal and at checkout). Shown once both are set.
# Google Cloud Console -> APIs & Services -> OAuth consent screen (External; scopes: openid, email, profile),
# then Credentials -> Create OAuth client ID -> Web application, with Authorised redirect URIs:
#   http://127.0.0.1:5000/auth/google/callback          (local)
#   https://<your-domain>/auth/google/callback          (live)
# Signing in links earlier guest orders placed with the same Gmail address.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public site URL used to build OAuth redirect URIs, e.g. https://ntslabel.com (set it in production, especially
# behind a proxy, so the redirect URI matches what is registered with Google exactly). Empty = use the request host.
PUBLIC_BASE_URL=

# Meta (Facebook/Instagram) sign-in: not implemented yet (services/auth_providers.py), stays disabled.
META_APP_ID=
META_APP_SECRET=

# Development only. Never 1 in production (the debugger allows remote code execution).
# With 1 and no Twilio, OTPs are printed to the console.
FLASK_DEBUG=0
