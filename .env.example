# Flask Configuration
SECRET_KEY=your_flask_secret_key_here

# MongoDB Configuration
# Connection URI for the MongoDB server. Defaults to localhost if left blank.
MONGO_URI=mongodb://localhost:27017/huba2z

# Razorpay API Credentials (for payment gateway integration)
RAZORPAY_KEY=your_razorpay_key_here
RAZORPAY_SECRET=your_razorpay_secret_here

# Twilio SMS API Credentials (for OTP phone authentication)
TWILIO_PHONE=your_twilio_phone_number_here
TWILIO_SID=your_twilio_sid_here
TWILIO_TOKEN=your_twilio_token_here

# Administrator Configuration
# UUID of the primary admin user account
ADMIN_USER_ID=your_admin_user_uuid_here

# Shiprocket API Credentials (for automated logistics and tracking)
SHIPROCKET_EMAIL=your_shiprocket_email_here
SHIPROCKET_PASSWORD=your_shiprocket_password_here
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=110046

# Data Encryption Keys
# Cryptography Fernet keys used for encrypting PII (phone number, address) in MongoDB.
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_general_encryption_key_here
PHONE_ENCRYPTION_KEY=your_phone_encryption_key_here
ADDRESS_ENCRYPTION_KEY=your_address_encryption_key_here
